{
  "version": "v1",
  "hooks": [
    {
      "name": "Contract Necromancer PreToolUse",
      "trigger": "PreToolUse",
      "action": {
        "type": "command",
        "command": "node ../../bin/necro.js hook pre"
      },
      "timeout": 300
    },
    {
      "name": "Contract Necromancer PostToolUse",
      "trigger": "PostToolUse",
      "matcher": "execute_bash|execute_pwsh|control_bash_process|control_pwsh_process|fs_write|str_replace|fs_append|delete_file",
      "action": {
        "type": "command",
        "command": "node ../../bin/necro.js hook post"
      },
      "timeout": 300
    },
    {
      "name": "Contract Necromancer Stop",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "node ../../bin/necro.js hook stop"
      },
      "timeout": 300
    }
  ]
}
